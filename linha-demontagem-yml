# Nome da nossa fabrica automatiza
name : minha primeira linha de montagem

@ Define QUANDO a fabrica deve começar a funcionar
on:
  #sempre que algum enviar peças novas {push} para o repositorio
  push:
  # fabrica so funciona se o envio acontencer na linha principal de produção (branch main)
    branches: [ main ]

# area onde fica as estações de trabalho na fabrica
jobs:

# nome da estação principal da linha principal
build-e-teste:

#define qual maquina/robo sera usado na fabrica
# aqui estamos usando um computador linux Ubntu usado pelo github
runs-on: Ubntu-latest

# lista de tarefas que os robos executarão
steps:

# primeira tarefa:
# o robo pega chasst do carro, ou seja baixa o codigo-fonte do projeto
 - name: 1. Pegar o chassi do carro (código-fonte)

        # Comando pronto do GitHub que copia os arquivos do repositório
        uses: actions/checkout@v3

      # Segunda tarefa:
      # A estação de montagem tenta montar o carro/projeto
      - name: 2. Estação de Build (Montagem)

        # Apenas simula uma montagem exibindo uma mensagem na tela
        run: echo "Construindo o projeto... Verificando se todas as peças se encaixam!"

      # Terceira tarefa:
      # O setor de qualidade verifica se tudo funciona corretamente
      - name: 3. Estação de Teste (Controle de Qualidade)

        # Apenas simula testes automáticos exibindo uma mensagem na tela
        run: echo "Rodando os testes automatizados... Verificando se a porta abre e fecha!"
