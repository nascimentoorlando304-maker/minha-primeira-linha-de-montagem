# Nome da nossa fábrica automatizada
name: Minha Primeira Linha de Montagem

# Define QUANDO a fábrica deve começar a funcionar
on:

  # Sempre que alguém enviar peças novas (push) para o repositório
  push:

    # A fábrica só funciona se o envio acontecer na linha principal de produção (branch main)
    branches: [ main ]

# Área onde ficam as estações de trabalho da fábrica
jobs:

  # Nome da estação principal da linha de montagem
  build-e-teste:

    # Define qual máquina/robô será usado na fábrica
    # Aqui estamos usando um computador Linux Ubuntu criado pelo GitHub
    runs-on: ubuntu-latest

    # Lista de tarefas que os robôs executarão
    steps:

      # Primeira tarefa:
      # O robô pega o chassi do carro, ou seja, baixa o código-fonte do projeto
      - name: 1. Pegar o chassi do carro (código-fonte)

        # Comando pronto do GitHub que copia os arquivos do repositório
        uses: actions/checkout@v3

      # Segunda tarefa:
      # A estação de montagem tenta montar o carro/projeto
      - name: 2. Estação de Build (Montagem)

        # Apenas simula uma montagem exibindo uma mensagem na tela
        run: echo "Construindo o projeto... Verificando se todas as peças se encaixam!"

      # Terceira tarefa:
      # O setor de qualidade verifica se tudo funciona corretamente
      - name: 3. Estação de Teste (Controle de Qualidade)

        # Apenas simula testes automáticos exibindo uma mensagem na tela
        run: echo "Rodando os testes automatizados... Verificando se a porta abre e fecha!"
